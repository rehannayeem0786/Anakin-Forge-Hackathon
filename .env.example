# ARGUS — environment configuration
#
# Nothing here is required. ARGUS runs keyless, LLM-less and offline out of the box.
# Copy to `.env` and fill in only what you want to unlock.

# ---------------------------------------------------------------- Anakin
# Optional. Zero Touch (no key) already covers scraping and read-only Wire actions.
# A free key gives 300 credits and unlocks crawl, agentic search, write actions
# and cloud browser sessions. Get one at https://anakin.io/signup
# ANAKIN_API_KEY=ak_live_xxxxxxxxxxxxxxxxxxxxxxxx
# ANAKIN_BASE_URL=https://api.anakin.io/v1
# ANAKIN_MCP_URL=https://mcp.anakin.io/mcp

# Residential egress country for scraping and browser sessions (ISO-2).
# ARGUS_COUNTRY=us

# ------------------------------------------------------- reasoning (optional)
# Any OpenAI-compatible chat-completions endpoint:
# OpenAI, OpenRouter, Groq, Together, Fireworks, vLLM, Ollama, LM Studio...
# Without this, ARGUS uses its built-in deterministic reasoner.
# ARGUS_LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# ARGUS_LLM_BASE_URL=https://api.openai.com/v1
# ARGUS_LLM_MODEL=gpt-4o-mini
#
# Local example (Ollama):
#   ARGUS_LLM_BASE_URL=http://localhost:11434/v1
#   ARGUS_LLM_API_KEY=ollama
#   ARGUS_LLM_MODEL=llama3.1

# ----------------------------------------------------------------- runtime
# Deterministic fixtures, no network calls at all. Great for a demo on bad wifi.
# ARGUS_OFFLINE=1
# ARGUS_HOST=127.0.0.1
# ARGUS_PORT=8787
# ARGUS_MAX_PARALLEL=4
# ARGUS_REQUEST_TIMEOUT=90
# ARGUS_ARTIFACTS_DIR=./artifacts
